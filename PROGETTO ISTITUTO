/* Stile base e reset interno per il footer */
.site-footer {
  background-color: #1a1a1a;
  color: #ffffff;
  padding: 70px 0 0 0;
  font-family: sans-serif;
  margin-top: 50px;
  overflow: hidden;
}

/* Griglia flessibile responsive per PC e Tablet */
.footer-container {
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 30px;
  padding: 0 20px 50px 20px;
  box-sizing: border-box;
}

/* Layout singole colonne */
.footer-column {
  flex: 1;
  min-width: 220px;
  box-sizing: border-box;
}

/* Intestazioni delle sezioni */
.footer-column h3 {
  font-size: 1.1rem;
  margin-top: 0;
  margin-bottom: 20px;
  border-bottom: 2px solid orange;
  padding-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* Paragrafi di testo */
.footer-column p {
  margin: 0 0 10px 0;
  line-height: 1.6;
  color: #dddddd;
}

/* Link di testo */
.footer-column a {
  color: #cccccc;
  text-decoration: none;
  transition: color 0.3s ease;
}

.footer-column a:hover {
  color: #ff6600;
  text-decoration: underline;
}

/* Contenitore bottoni per App Store / Google Play */
.download-badges {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer-column .badge {
  display: block;
  max-width: 200px;
  background-color: #333333;
  color: #ffffff;
  padding: 12px 16px;
  border-radius: 6px;
  font-size: 0.85rem;
  text-align: center;
  font-weight: bold;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.footer-column .badge:hover {
  background-color: #ff6600;
  color: #1a1a1a;
  text-decoration: none;
}

/* Canali Social */
.social-links {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.social-links a {
  font-size: 0.95rem;
  display: flex;
  align-items: center;
}

.social-links a::before {
  display: inline-block;
  width: 20px;
  margin-right: 10px;
  text-align: center;
}

.social-links a.facebook::before { content: "ƒ"; font-weight: bold; color: #1877f2; }
.social-links a.instagram::before { content: "◉"; color: #e1306c; }
.social-links a.youtube::before { content: "▶"; color: #ff0000; }

/* Blocco inferiore nero */
.footer-bottom {
  border-top: 1px solid #333333;
  background-color: #111111;
  width: 100%;
  padding: 30px ;
  box-sizing: border-box;
}

/* Layout interno del blocco legale */
.footer-bottom-inner {
  max-width: 1200px;
  margin: 0 auto;
